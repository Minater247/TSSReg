{
  "manifest_version": 3,
  "name": "TSSReg",
  "version": "0.1.0",
  "description": "Unofficial rework of UCSD's TSS to improve the user experience",
  "homepage_url": "https://github.com/Minater247/TSSReg",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://tss.ucsd.edu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tss.ucsd.edu/*"
      ],
      "js": [
        "timezone-fix.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tss.ucsd.edu/fiori*"
      ],
      "css": [
        "soc-filters.css",
        "overview.css",
        "shell.css",
        "courses.css"
      ],
      "js": [
        "soc-search-normalize.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tss.ucsd.edu/fiori*"
      ],
      "js": [
        "soc-shared.js",
        "shell-session.js",
        "soc-filters.js",
        "soc-credits-range.js",
        "soc-dow-buttons.js",
        "soc-availability.js",
        "soc-timeofday.js",
        "soc-conflict.js",
        "overview-layout.js",
        "overview-notices.js",
        "overview-calendar.js",
        "overview-identity.js",
        "overview-quicklinks.js",
        "courses-plans.js",
        "courses-page.js",
        "courses-catalog.js",
        "courses-export.js",
        "courses-calendar.js",
        "courses-detail.js",
        "courses-finder.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tssreg@minater247.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
